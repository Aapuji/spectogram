{
  "version": 2,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "VCPKG_DEFAULT_HOST_TRIPLET": "x64-mingw-static"
      },
      "cacheVariables": {
